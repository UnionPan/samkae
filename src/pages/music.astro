---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`music - ${SITE_TITLE}`} description="Music by Samantha Kenny" />
	</head>
	<body>
		<div class="page-container vintage">
			<div class="nav-card" title="back to home">
				<ul class="nav-links">
					<li><a href="/photo">photo</a></li>
					<li><a href="/blog">blog</a></li>
					<li><a href="/music" class="active">music</a></li>
					<li><a href="/projects">shop</a></li>
					<li><a href="/videos">news</a></li>
				</ul>
				<div class="social-links">
					<a href="https://www.youtube.com/@samkaeeee" aria-label="YouTube" target="_blank" rel="noopener noreferrer">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M23 9.71a8.5 8.5 0 00-.91-4.13 2.92 2.92 0 00-1.72-1A78.36 78.36 0 0012 4.27a78.45 78.45 0 00-8.34.3 2.87 2.87 0 00-1.46.74c-.9.83-1 2.25-1.1 3.45a48.29 48.29 0 000 6.48 9.55 9.55 0 00.3 2 3.14 3.14 0 00.71 1.36 2.86 2.86 0 001.49.78 45.18 45.18 0 006.5.33c3.5.05 6.57 0 10.2-.28a2.88 2.88 0 001.53-.78 2.49 2.49 0 00.61-1 10.58 10.58 0 00.52-3.4c.04-.56.04-3.94.04-4.54zM9.74 14.85V8.66l5.92 3.11c-1.66.92-3.85 1.96-5.92 3.08z" fill="currentColor"/>
						</svg>
					</a>
					<a href="https://open.spotify.com/artist/3qo9BlnVduy6nW0pY1kmTQ" aria-label="Spotify" target="_blank" rel="noopener noreferrer">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 14.5c-.17.3-.52.4-.81.23-2.23-1.36-5.03-1.67-8.34-.92-.32.07-.65-.13-.72-.46-.07-.32.13-.65.46-.72 3.61-.82 6.73-.47 9.23 1.06.29.18.39.53.18.81zm1.15-2.56c-.22.37-.68.49-1.05.27-2.55-1.57-6.44-2.02-9.46-1.1-.39.12-.8-.1-.92-.49-.12-.39.1-.8.49-.92 3.44-1.05 7.76-.54 10.67 1.27.37.21.48.68.27 1.07zm.1-2.67C14.76 9 8.59 8.77 5 9.99c-.45.15-.92-.09-1.07-.54-.15-.45.09-.92.54-1.07 4.13-1.4 10.96-1.13 14.41.98.42.25.56.8.3 1.22-.25.42-.8.56-1.22.3z" fill="currentColor"/>
						</svg>
					</a>
					<a href="https://www.instagram.com/samkaeeee/" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
							<rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="2"/>
							<circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
							<circle cx="18" cy="6" r="1" fill="currentColor"/>
						</svg>
					</a>
					<a href="https://www.tiktok.com/@samkaeeeee" aria-label="TikTok" target="_blank" rel="noopener noreferrer">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1-.1z" fill="currentColor"/>
						</svg>
					</a>
					<a href="https://samkae.bandcamp.com/" aria-label="Bandcamp" target="_blank" rel="noopener noreferrer">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M0 18.75l7.437-13.5H24l-7.438 13.5H0z" fill="currentColor"/>
						</svg>
					</a>
				</div>
				<p class="copyright">© 2021–{new Date().getFullYear()} samkae all rights reserved.</p>
			</div>

			<section class="content">
				<header class="masthead reveal">
					<div class="masthead-row">
						<span class="kicker">side a</span>
						<span class="kicker">discography</span>
					</div>
					<h1>music</h1>
					<p class="dek">records, sessions &amp; sounds — pressed in small numbers</p>
				</header>

				<div class="records">
					<article class="record reveal" style="--i: 1; --label: #b8322a">
						<div class="sleeve">
							<div class="vinyl"></div>
							<div class="cover">
								<span class="art art-sun"></span>
								<span class="cover-name">sam kae</span>
								<span class="cover-cat">SK—001</span>
							</div>
						</div>
						<p class="record-meta"><span>SK—001</span><span>single</span></p>
						<h3 class="record-title">untitled i</h3>
						<p class="record-note">forthcoming</p>
					</article>
					<article class="record reveal" style="--i: 2; --label: #d9a441">
						<div class="sleeve">
							<div class="vinyl"></div>
							<div class="cover">
								<span class="art art-stripes"></span>
								<span class="cover-name">sam kae</span>
								<span class="cover-cat">SK—002</span>
							</div>
						</div>
						<p class="record-meta"><span>SK—002</span><span>ep</span></p>
						<h3 class="record-title">untitled ii</h3>
						<p class="record-note">forthcoming</p>
					</article>
					<article class="record reveal" style="--i: 3; --label: #2e6b4f">
						<div class="sleeve">
							<div class="vinyl"></div>
							<div class="cover">
								<span class="art art-dots"></span>
								<span class="cover-name">sam kae</span>
								<span class="cover-cat">SK—003</span>
							</div>
						</div>
						<p class="record-meta"><span>SK—003</span><span>cassette</span></p>
						<h3 class="record-title">demos, vol. 1</h3>
						<p class="record-note">forthcoming</p>
					</article>
					<article class="record reveal" style="--i: 4; --label: #f1e9d8">
						<div class="sleeve">
							<div class="vinyl"></div>
							<div class="cover">
								<span class="art art-rings"></span>
								<span class="cover-name">sam kae</span>
								<span class="cover-cat">SK—004</span>
							</div>
						</div>
						<p class="record-meta"><span>SK—004</span><span>lp</span></p>
						<h3 class="record-title">live recordings</h3>
						<p class="record-note">forthcoming</p>
					</article>
				</div>

				<div class="listen reveal" style="--i: 5">
					<span class="kicker">listen now</span>
					<a href="https://open.spotify.com/artist/3qo9BlnVduy6nW0pY1kmTQ" target="_blank" rel="noopener noreferrer">spotify ↗</a>
					<a href="https://www.youtube.com/@samkaeeee" target="_blank" rel="noopener noreferrer">youtube ↗</a>
					<a href="https://samkae.bandcamp.com/" target="_blank" rel="noopener noreferrer">bandcamp ↗</a>
				</div>
			</section>
		</div>

		<script is:inline>
			(function() {
				const theme = localStorage.getItem('theme') || 'light';
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>
	</body>
</html>
